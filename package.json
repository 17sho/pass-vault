{
  "name": "pass-vault-v2",
  "version": "1.1.72",
  "private": true,
  "description": "Mobile-first encrypted vault with one browser frontend packaged for independent Cloudflare D1/R2 and Linux SQLite deployments",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/17sho/pass-vault-v2.git"
  },
  "bugs": {
    "url": "https://github.com/17sho/pass-vault-v2/issues"
  },
  "homepage": "https://github.com/17sho/pass-vault-v2#readme",
  "packageManager": "npm@11",
  "type": "module",
  "scripts": {
    "pretest": "node scripts/build.mjs",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.js",
    "lint": "node scripts/check.mjs",
    "lint:docs": "node scripts/check-docs.mjs",
    "typecheck": "tsc --noEmit -p apps/worker/tsconfig.json",
    "build": "node scripts/build.mjs",
    "start": "node apps/server/server.mjs",
    "package:release": "node scripts/package-release.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "miniflare": "4.20260722.1",
    "playwright": "^1.61.1",
    "typescript": "latest",
    "wrangler": "4.115.0"
  },
  "overrides": {
    "undici": "7.29.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@simplewebauthn/server": "13.3.2",
    "pdfjs-dist": "^4.10.38"
  }
}
