{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pass-vault-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-11",
  "workers_dev": false,
  "routes": [
    { "pattern": "admin.pass.23cm.me", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pass-vault-v2",
      "database_id": "[REDACTED]"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "vault-attachments-prod"
    }
  ],
  "vars": {
    "ADMIN_EMAIL": "[REDACTED]",
    "APP_VERSION": "1.1.72"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
