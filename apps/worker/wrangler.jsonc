{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pass-vault",
  "workers_dev": true,
  "preview_urls": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-07-11",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "YOUR_D1_DATABASE_NAME",
      "database_id": "YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "your-r2-attachments-bucket"
    }
  ],
  "vars": {
    "APP_VERSION": "2.2.3",
    "APP_ORIGIN": "https://pass.example.com"
  },
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true
    }
  },
  "triggers": {
    "crons": ["17 * * * *"]
  }
}
